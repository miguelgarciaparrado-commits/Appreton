{
  "expo": {
    "name": "Appreton",
    "slug": "Appreton",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#8B6914"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.appreton.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Appreton necesita tu ubicacion para encontrar banos cercanos.",
        "NSCameraUsageDescription": "Appreton necesita acceso a la camara para tomar fotos de los banos.",
        "NSPhotoLibraryUsageDescription": "Appreton necesita acceso a tus fotos para subir imagenes de los banos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#8B6914"
      },
      "package": "com.appreton.app",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 34,
            "buildToolsVersion": "35.0.0",
            "kotlinVersion": "1.9.25",
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Appreton necesita tu ubicacion para encontrar banos cercanos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Appreton necesita acceso a tus fotos para subir imagenes de los banos.",
          "cameraPermission": "Appreton necesita acceso a la camara para tomar fotos de los banos."
        }
      ]
    ]
  }
}
