{
  "expo": {
    "name": "Appreton",
    "slug": "Appreton",
    "version": "1.4.0",
    "scheme": "appreton",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#8B6914"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.appreton.app",
      "config": {
        "googleMapsApiKey": "AIzaSyAGsJx_0fUzJmVDA539E5zo_mDfLBvKRMA"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Appreton necesita tu ubicacion para encontrar banos cercanos.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Appreton te avisa cuando estas en un establecimiento para que puedas opinar sobre su WC, aunque la app este cerrada.",
        "NSLocationAlwaysUsageDescription": "Appreton te avisa cuando estas en un establecimiento para que puedas opinar sobre su WC, aunque la app este cerrada.",
        "UIBackgroundModes": ["location", "fetch"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#8B6914"
      },
      "package": "com.appreton.app",
      "versionCode": 5,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "CAMERA"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAGsJx_0fUzJmVDA539E5zo_mDfLBvKRMA"
        }
      }
    },
    "extra": {
      "eas": {
        "projectId": "bcb8a40b-9e78-4ab9-930e-f9adc5bebb75"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/set-java-home",
      "./plugins/patch-async-storage",
      "./plugins/patch-expo-modules",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 34,
            "buildToolsVersion": "35.0.0",
            "minSdkVersion": 24,
            "ndkVersion": "27.1.12297006"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Appreton necesita tu ubicacion para encontrar banos cercanos.",
          "locationAlwaysAndWhenInUsePermission": "Appreton te avisa cuando estas en un establecimiento para que puedas opinar sobre su WC.",
          "locationAlwaysPermission": "Appreton te avisa cuando estas en un establecimiento para que puedas opinar sobre su WC.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#8B6914",
          "defaultChannel": "appreton-proximity"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Appreton necesita acceso a tus fotos para subir imagenes de los banos.",
          "cameraPermission": "Appreton necesita acceso a la camara para tomar fotos de los banos."
        }
      ]
    ]
  }
}
